{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Beauty Studio",
  "version": "2.0.0",
  "identifier": "com.piecake.aibeautystudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Beauty Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../../engine/dist/bin/*.dll": "./",
      "../../../models/registry.json": "models/registry.json",
      "../../../models/files/*": "models/files/",
      "../../../models/licenses/*": "models/licenses/",
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "aibs"
        ],
        "name": "AI Beauty Studio Project",
        "description": "AI Beauty Studio project",
        "role": "Editor"
      }
    ]
  }
}
